# ═══════════════════════════════════════════════════════════
# MyMind Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Telegram Bot ─────────────────────────────────────────
# Get this from @BotFather on Telegram:
# 1. Open Telegram, search for @BotFather
# 2. Send /newbot
# 3. Choose a name (e.g., "MyMind")
# 4. Choose a username (e.g., "mymind_brain_bot")
# 5. Copy the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram User ID (so only YOU can use the bot)
# To find it: send any message to @userinfobot on Telegram
TELEGRAM_USER_ID=your_user_id_here

# ─── Groq AI ─────────────────────────────────────────────
# Get a free API key from https://console.groq.com/keys
# Free tier: 14,400 requests/day, no credit card needed
GROQ_API_KEY=your_groq_api_key_here

# ─── Storage (defaults work fine for local development) ──
# DB_PATH=./data/mymind.db
# IMAGES_DIR=./data/images
# AUDIO_DIR=./data/audio

# ─── API Server (Phase 2) ────────────────────────────────
# PORT=3001
# API_AUTH_TOKEN=generate-a-random-token-here
